{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tracecraft:receipt:v2",
  "title": "Execution receipt with selected input binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "observation",
    "binding"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "kind": {
      "const": "execution-receipt"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "provenance",
        "scope",
        "argv",
        "cwd",
        "startedAt",
        "endedAt",
        "durationMs",
        "outcome",
        "exitCode",
        "signal",
        "errorCode",
        "outputComplete",
        "stdout",
        "stderr"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "provenance": {
          "const": "runner"
        },
        "scope": {
          "const": "process-execution-only"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "startedAt": {
          "type": "string"
        },
        "endedAt": {
          "type": "string"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "enum": [
            "exited-zero",
            "exited-nonzero",
            "spawn-error",
            "signalled",
            "timed-out",
            "cancelled"
          ]
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "signal": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "outputComplete": {
          "type": "boolean"
        },
        "stdout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "truncated",
            "observedBytes"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "truncated": {
              "type": "boolean"
            },
            "observedBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "stderr": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "truncated",
            "observedBytes"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "truncated": {
              "type": "boolean"
            },
            "observedBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "featurePath",
        "configPath",
        "commandId",
        "before",
        "after",
        "state",
        "errorCode"
      ],
      "properties": {
        "featurePath": {
          "type": "string",
          "minLength": 1
        },
        "configPath": {
          "type": "string",
          "minLength": 1
        },
        "commandId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "before": {
          "$ref": "#/$defs/fingerprint"
        },
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/fingerprint"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "unchanged",
            "changed",
            "unavailable"
          ]
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "algorithm",
        "scope",
        "paths",
        "exclude",
        "files",
        "digest"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "algorithm": {
          "const": "sha256"
        },
        "scope": {
          "const": "selected-files"
        },
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 10000,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 10000,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "files": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "bytes",
              "sha256",
              "executable"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8388608
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "executable": {
                "type": "boolean"
              }
            }
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
