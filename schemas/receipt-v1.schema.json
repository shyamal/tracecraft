{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tracecraft:receipt:v1",
  "title": "Execution receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "observation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "execution-receipt"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "provenance",
        "scope",
        "argv",
        "cwd",
        "startedAt",
        "endedAt",
        "durationMs",
        "outcome",
        "exitCode",
        "signal",
        "errorCode",
        "outputComplete",
        "stdout",
        "stderr"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "provenance": {
          "const": "runner"
        },
        "scope": {
          "const": "process-execution-only"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "startedAt": {
          "type": "string"
        },
        "endedAt": {
          "type": "string"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "enum": [
            "exited-zero",
            "exited-nonzero",
            "spawn-error",
            "signalled",
            "timed-out",
            "cancelled"
          ]
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "signal": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "outputComplete": {
          "type": "boolean"
        },
        "stdout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "truncated",
            "observedBytes"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "truncated": {
              "type": "boolean"
            },
            "observedBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "stderr": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "truncated",
            "observedBytes"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "truncated": {
              "type": "boolean"
            },
            "observedBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
