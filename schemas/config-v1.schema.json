{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tracecraft:config:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "commands"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "commands": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argv"
        ],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[^\\u0000]*$"
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "env": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[^=\\u0000]+$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[^\\u0000]*$"
            }
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600000
          },
          "maxOutputBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "redact": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "inputs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "paths"
            ],
            "properties": {
              "paths": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 10000,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "exclude": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 10000,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
